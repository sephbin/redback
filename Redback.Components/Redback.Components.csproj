<Project Sdk="Microsoft.NET.Sdk">

  <!-- Auto-incrementing version. Gitignored; auto-created on first build. -->
  <Import Project="BuildVersion.props" Condition="Exists('BuildVersion.props')" />
  <PropertyGroup Condition="'$(BuildCounter)' == ''">
    <VersionMajor>0</VersionMajor>
    <VersionMinor>5</VersionMinor>
    <VersionPatch>44</VersionPatch>
    <BuildCounter>0</BuildCounter>
  </PropertyGroup>
  <PropertyGroup>
    <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetExt>.gha</TargetExt>
    <!-- net48: targets .NET Framework 4.8, which is what Revit 2023/2024 RiR runs plugins under.
         .NET 7 and .NET 8 hosts (standalone Rhino 8, Revit 2025+) load net48 assemblies via
         backwards compatibility, so this single TFM covers all supported environments. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <AssemblyName>Redback.Components</AssemblyName>
    <AssemblyVersion>$(Version).$(BuildCounter)</AssemblyVersion>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" PrivateAssets="all" />
    <PackageReference Include="RhinoCommon" Version="8.21.*" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.21.*" ExcludeAssets="runtime" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Generate version attributes from BuildVersion.props so the assembly version matches the
       Yak manifest version. AssemblyInfo.cs intentionally omits version attributes; this target
       writes them to a file in obj/ (not tracked by git, not in the auto-include glob) so the
       version increments correctly on every build. -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_AssemblyVer>$(VersionMajor).$(VersionMinor).$(VersionPatch).$(BuildCounter)</_AssemblyVer>
      <_InfoVer>$(VersionMajor).$(VersionMinor).$(VersionPatch)+$(BuildCounter)</_InfoVer>
    </PropertyGroup>
    <ItemGroup>
      <_VInfoLines Include="// Auto-generated by GenerateVersionInfo target — do not edit." />
      <_VInfoLines Include="using System.Reflection%3B" />
      <_VInfoLines Include="[assembly: AssemblyVersion(&quot;$(_AssemblyVer)&quot;)]" />
      <_VInfoLines Include="[assembly: AssemblyFileVersion(&quot;$(_AssemblyVer)&quot;)]" />
      <_VInfoLines Include="[assembly: AssemblyInformationalVersion(&quot;$(_InfoVer)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)VersionInfo.g.cs" Lines="@(_VInfoLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Kill any processes that lock the .gha before we try to copy it. -->
  <Target Name="KillGHLockers" BeforeTargets="CopyToGHLibraries">
    <Exec Command="powershell -NonInteractive -Command &quot;Get-Process Rhino,compute.geometry -ErrorAction SilentlyContinue | Stop-Process -Force&quot;"
          IgnoreExitCode="true" />
  </Target>

  <!-- Copy the built .gha to Grasshopper's Libraries folder so GH discovers the components on next launch. -->
  <!-- Also copies runtime dependency DLLs (e.g. Svg.NET and its deps) so they are resolvable. -->
  <Target Name="CopyToGHLibraries" AfterTargets="Build">
    <PropertyGroup>
      <GHLibDir>$(APPDATA)\Grasshopper\Libraries\Redback\</GHLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(GHLibDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GHLibDir)Redback.Components.gha" />
    <ItemGroup>
      <_DepDlls Include="$(OutputPath)*.dll" Exclude="$(OutputPath)Redback.Components.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DepDlls)" DestinationFolder="$(GHLibDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="--- Copied to $(GHLibDir)Redback.Components.gha ---" />
  </Target>

  <!-- Build a .yak package for Rhino Package Manager after each Debug build. -->
  <Target Name="BuildYakPackage" AfterTargets="CopyToGHLibraries" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <YakExe Condition="'$(YakExe)' == ''">C:\Program Files\Rhino 8\System\Yak.exe</YakExe>
      <YakVersion>$(Version)+$(BuildCounter)</YakVersion>
      <YakDir>$(MSBuildProjectDirectory)\..\yak-build\</YakDir>
      <YakArchiveDir>$(MSBuildProjectDirectory)\..\yak-archive\</YakArchiveDir>
    </PropertyGroup>
    <RemoveDir Directories="$(YakDir)" />
    <MakeDir Directories="$(YakDir)" />
    <ItemGroup>
      <_YakManifest Include="---" />
      <_YakManifest Include="name: Redback" />
      <_YakManifest Include="version: $(YakVersion)" />
      <_YakManifest Include="authors:" />
      <_YakManifest Include="- Andrew Butler" />
      <_YakManifest Include="description: ''" />
      <_YakManifest Include="license: ''" />
      <_YakManifest Include="url: ''" />
      <_YakManifest Include="keywords:" />
      <_YakManifest Include="- guid:7d142de6-7a37-4b73-961b-a5ef3f7bfbc8" />
    </ItemGroup>
    <WriteLinesToFile File="$(YakDir)manifest.yml" Lines="@(_YakManifest)" Overwrite="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YakDir)" />
    <ItemGroup>
      <_YakDlls Include="$(OutputPath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_YakDlls)" DestinationFolder="$(YakDir)" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(YakExe)&quot; build"
          WorkingDirectory="$(YakDir)"
          Condition="Exists('$(YakExe)')" />
    <Warning Text="Yak.exe not found at $(YakExe) — skipping .yak package build."
             Condition="!Exists('$(YakExe)')" />
    <MakeDir Directories="$(YakArchiveDir)" />
    <ItemGroup>
      <_BuiltYak Include="$(YakDir)*.yak" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuiltYak)" DestinationFolder="$(YakArchiveDir)" />
    <Message Importance="high" Text="--- Yak package ready: $(YakArchiveDir)redback-$(YakVersion)-rh8-any.yak ---" />
  </Target>

  <!-- Increment version patch and build counter after each build. -->
  <Target Name="IncrementBuildVersion" AfterTargets="Build">
    <PropertyGroup>
      <NextPatch>$([MSBuild]::Add($(VersionPatch), 1))</NextPatch>
      <NextCounter>$([MSBuild]::Add($(BuildCounter), 1))</NextCounter>
    </PropertyGroup>
    <ItemGroup>
      <_VLines Include="&lt;Project&gt;" />
      <_VLines Include="  &lt;PropertyGroup&gt;" />
      <_VLines Include="    &lt;VersionMajor&gt;$(VersionMajor)&lt;/VersionMajor&gt;" />
      <_VLines Include="    &lt;VersionMinor&gt;$(VersionMinor)&lt;/VersionMinor&gt;" />
      <_VLines Include="    &lt;VersionPatch&gt;$(NextPatch)&lt;/VersionPatch&gt;" />
      <_VLines Include="    &lt;BuildCounter&gt;$(NextCounter)&lt;/BuildCounter&gt;" />
      <_VLines Include="  &lt;/PropertyGroup&gt;" />
      <_VLines Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\BuildVersion.props"
                      Lines="@(_VLines)"
                      Overwrite="true" />
    <Message Importance="high" Text="--- Build complete. Next version: $(VersionMajor).$(VersionMinor).$(NextPatch) (build $(NextCounter)) ---" />
  </Target>

</Project>
